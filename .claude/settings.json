{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git branch -d *)",
      "Bash(git merge-base *)",
      "Bash(git fetch *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git restore --staged *)",
      "Bash(git commit *)",
      "Bash(git merge origin/develop)",
      "Bash(git merge --no-ff *)",
      "Bash(git merge --abort)",
      "Bash(git worktree add *)",
      "Bash(git worktree list*)",
      "Bash(git push -u origin *)",
      "Bash(git push origin *)",
      "Bash(gh auth status)",
      "Bash(gh repo view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue close *)",
      "Bash(gh pr view *)",
