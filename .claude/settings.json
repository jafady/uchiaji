      "Bash(git push origin main *)",
      "Bash(git push -u origin main)",
      "Bash(git push -u origin main *)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push -uf*)",
      "Bash(git push -fu*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * -uf*)",
      "Bash(git push * -fu*)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * -d *)",
      "Bash(git push * :*)",
      "Bash(git push *--all*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--prune*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git push *--no-verify*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit * -n*)",
      "Bash(git * --output*)",
      "Bash(git switch -f*)",
      "Bash(git switch * -f*)",
      "Bash(git switch *--force*)",
      "Bash(git switch *--discard-changes*)",
      "Bash(git restore *--worktree*)",
      "Bash(git restore * -W*)",
      "Bash(git branch -d * -f*)",
      "Bash(git branch -d *--force*)",
      "Bash(git reset --hard *)",
      "Bash(git reset * --hard*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(gh pr merge *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh secret *)",
      "Bash(gh auth token*)",
