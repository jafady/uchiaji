    "ask": [
      "Bash(gh repo create *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)",
      "Bash(git stash *)",
      "Bash(gh api * -X *)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api *--field*)",
