      "Bash(gh auth status *--show-token*)",
      "Bash(gh api *merge*)",
      "Bash(gh api graphql*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *protection*)",
      "Bash(gh api *secrets*)",
      "Bash(gh api *variables*)",
      "Bash(gh api *environments*)",
      "Bash(gh api *pending_deployments*)",
      "Bash(gh api *DELETE*)",
      "Bash(gh api *PATCH*)",
      "Bash(gh api *PUT*)",
      "Bash(wrangler deploy*)",
      "Bash(wrangler versions *)",
      "Bash(wrangler pages deploy*)",
      "Bash(wrangler secret *)",
      "Bash(wrangler publish*)",
      "Bash(wrangler delete*)",
      "Bash(wrangler rollback*)",
      "Bash(wrangler d1 delete*)",
      "Bash(wrangler d1 time-travel*)",
      "Bash(wrangler d1 * --remote*)",
      "Bash(npx *wrangler* deploy*)",
      "Bash(npx *wrangler* versions *)",
      "Bash(npx *wrangler* secret *)",
      "Bash(npx *wrangler* delete*)",
      "Bash(npx *wrangler* rollback*)",
      "Bash(npx *wrangler* d1 delete*)",
      "Bash(npx *wrangler* d1 time-travel*)",
      "Bash(npx *wrangler* d1 * --remote*)",
      "Bash(pnpm *wrangler* deploy*)",
      "Bash(pnpm *wrangler* versions *)",
      "Bash(pnpm *wrangler* secret *)",
      "Bash(pnpm *wrangler* delete*)",
      "Bash(pnpm *wrangler* rollback*)",
      "Bash(pnpm *wrangler* d1 delete*)",
      "Bash(pnpm *wrangler* d1 time-travel*)",
